# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=ai_task_kb

# JWT
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Uploads / vector store
UPLOAD_DIR=uploads
VECTOR_STORE_DIR=vector_store

# Embedding model (runs locally via sentence-transformers, no external API calls)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
